# SRS §3.4 Secrets 金鑰管理:正式環境一律使用 GitHub Organization Secrets 注入,
# 本檔案僅供本機開發參考,切勿填入真實金鑰後提交。

# Notion Internal Integration 的 Token(notion.so/my-integrations)
NOTION_API_KEY=

# 四個 Notion 資料庫的 Database ID(資料庫網址列中 32 碼那段,不含 ?v= 後面的部分)
NOTION_DB_PROJECTS=
NOTION_DB_EXP=
NOTION_DB_SKILLS=
NOTION_DB_PEOPLE=
